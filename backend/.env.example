# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://n8n_clone:n8n_clone@localhost:5432/n8n_clone?schema=public"

# Redis & Queue
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Credentials Manager (Phase 8)
# Must be a 32-byte key, hex-encoded (64 hex characters)
# Generate one with: openssl rand -hex 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
